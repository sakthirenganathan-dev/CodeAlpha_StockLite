# Allowed CORS Origins (comma-separated URLs)
# Local development:
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173

# Production (specify your Vercel deployment URL):
# CORS_ORIGINS=https://your-portfolio-app.vercel.app

# Set to true only in development if testing from any host:
ALLOW_ALL_CORS=false

# Port configuration
PORT=8000
